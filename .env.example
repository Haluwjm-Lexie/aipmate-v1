# 复制本文件为 .env.local，填写后重启。不要把 .env.local 上传到 GitHub。
# 本地个人版无需工作台访问口令。
# 必填：从你的 DeepSeek 控制台获取；没有密钥也能查看演示、管理项目、编辑文档。
DEEPSEEK_API_KEY=
# 必填：填写账号当前可用的准确模型 ID，以官方控制台为准。
DEEPSEEK_MODEL=
# 官方地址；兼容服务需支持 Chat Completions 和 JSON Output。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 本地默认 ./data；在线版必须改为持久化磁盘路径，例如 /app/data。
DATA_DIR=./data
NEXT_TELEMETRY_DISABLED=1
